---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="ABG Interpretation Educational Tool for Nursing Students" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/abg/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-200">
    <slot />
  </body>
</html>
