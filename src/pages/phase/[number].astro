---
import Layout from '../../layouts/Layout.astro';
import { phases } from '../../data/phases';

export function getStaticPaths() {
  return phases.map((phase) => ({
    params: { number: String(phase.number) },
  }));
}

const { number } = Astro.params;
const phase = phases.find((p) => String(p.number) === number);

if (!phase) {
  return Astro.redirect('/abg/');
}

const prevPhase = phases.find((p) => p.number === phase.number - 1);
const nextPhase = phases.find((p) => p.number === phase.number + 1);
---

<Layout title={`Phase ${phase.number}: ${phase.title} — ABG Interpretation`}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">

    <!-- Back link -->
    <div class="mb-6">
      <a href="/abg/" class="btn btn-ghost btn-sm gap-2">
        ← Back to Timeline
      </a>
    </div>

    <!-- Hero -->
    <div class={`hero rounded-box shadow-lg mb-10 py-12 bg-base-100`}>
      <div class="hero-content text-center">
        <div class="max-w-2xl">
          <div class="text-6xl mb-4">{phase.icon}</div>
          <div class={`badge ${phase.badge} badge-lg mb-4`}>Phase {phase.number}</div>
          <h1 class="text-3xl font-bold text-base-content mb-4">{phase.title}</h1>
          <p class="text-base-content/70 text-lg italic">
            <strong>Purpose:</strong> {phase.purpose}
          </p>
        </div>
      </div>
    </div>

    <!-- Steps -->
    <div class="card bg-base-100 shadow-md mb-8">
      <div class="card-body">
        <h2 class="card-title text-xl mb-4">Learning Objectives & Activities</h2>
        <ul class="list-disc list-inside space-y-3 text-base-content/80">
          {phase.steps.map((step) => (
            <li class="text-sm leading-relaxed">{step}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Optional: Table -->
    {phase.table && (
      <div class="card bg-base-100 shadow-md mb-8">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Reference Table</h2>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  {phase.table.headers.map((h) => <th>{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {phase.table.rows.map((row) => (
                  <tr>
                    {row.map((cell) => <td class="font-medium">{cell}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    <!-- Optional: Matrix -->
    {phase.matrix && (
      <div class="card bg-base-100 shadow-md mb-8">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Acid-Base Disorder Matrix</h2>
          <div class="overflow-x-auto">
            <table class="table table-bordered text-center">
              <thead>
                <tr>
                  <th></th>
                  {phase.matrix.cols.map((col) => (
                    <th class="text-error text-base">{col}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {phase.matrix.rows.map((row) => (
                  <tr>
                    <th class="text-info">{row.label}</th>
                    <td class="whitespace-pre-line text-sm">{row.acidosis}</td>
                    <td class="whitespace-pre-line text-sm">{row.alkalosis}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    <!-- Optional: 5-Step Framework -->
    {phase.fiveSteps && (
      <div class="card bg-base-100 shadow-md mb-8">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">The 5-Step Framework</h2>
          <div class="alert alert-warning mb-4">
            <span class="text-sm">Use this systematic method every time — it prevents errors that pattern-matching shortcuts invite.</span>
          </div>
          <ul class="steps steps-vertical w-full">
            {phase.fiveSteps.map((s) => (
              <li class="step step-warning">
                <div class="text-left ml-2">
                  <span class="font-semibold">Step {s.step} — {s.label}:</span>
                  <span class="text-sm text-base-content/70"> {s.detail}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Phase navigation -->
    <div class="flex justify-between items-center mt-10">
      {prevPhase ? (
        <a href={`/abg/phase/${prevPhase.number}`} class={`btn btn-outline gap-2`}>
          ← Phase {prevPhase.number}
        </a>
      ) : (
        <div />
      )}
      {nextPhase ? (
        <a href={`/abg/phase/${nextPhase.number}`} class={`btn ${nextPhase.badge.replace('badge-', 'btn-')} gap-2`}>
          Phase {nextPhase.number} →
        </a>
      ) : (
        <div />
      )}
    </div>

    <!-- Footer -->
    <footer class="footer footer-center p-6 mt-10 text-base-content/50 text-sm">
      <p>ABG Interpretation Educational Tool · Built with <a href="https://astro.build" class="link link-primary">Astro</a> & <a href="https://daisyui.com" class="link link-primary">DaisyUI</a></p>
    </footer>
  </div>
</Layout>
