---
import Layout from '../layouts/Layout.astro';
import { phases, pedagogicalPrinciples } from '../data/phases';
---

<Layout title="ABG Interpretation — Educational Sequence for Nursing Students">
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <!-- Header -->
    <div class="hero bg-base-100 rounded-box shadow-lg mb-10 py-10">
      <div class="hero-content text-center">
        <div class="max-w-3xl">
          <div class="badge badge-primary badge-lg mb-4">Nursing Education</div>
          <h1 class="text-4xl font-bold text-base-content mb-4">
            Educational Sequence: Teaching ABG Interpretation to Nursing Students
          </h1>
          <p class="text-base-content/70 text-lg">
            A carefully scaffolded, linear instructional sequence built on the principle of
            <strong>moving from foundational knowledge → conceptual understanding → systematic skill → clinical application</strong>.
          </p>
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
      {phases.map((phase, index) => {
        const isEven = index % 2 === 0;
        return (
          <li>
            {index > 0 && <hr class="bg-primary" />}
            <div class="timeline-middle">
              <div class={`badge ${phase.badge} badge-lg text-lg w-10 h-10 flex items-center justify-center`}>
                {phase.icon}
              </div>
            </div>
            <div class={`${isEven ? 'timeline-start md:text-end' : 'timeline-end'} mb-10`}>
              <div class="collapse collapse-arrow bg-base-100 shadow-md hover:shadow-xl transition-shadow duration-300 text-left rounded-box">
                <input type="checkbox" />
                <div class="collapse-title">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`badge ${phase.badge}`}>Phase {phase.number}</span>
                    <span class="font-semibold text-lg">{phase.title}</span>
                  </div>
                  <p class="text-base-content/60 italic text-sm mt-1">Purpose: {phase.purpose}</p>
                </div>
                <div class="collapse-content">
                  <ul class="list-disc list-inside space-y-1 mt-2 text-sm text-base-content/80">
                    {phase.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ul>

                  {phase.table && (
                    <div class="overflow-x-auto mt-4">
                      <table class="table table-zebra table-sm">
                        <thead>
                          <tr>
                            {phase.table.headers.map((h) => <th>{h}</th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {phase.table.rows.map((row) => (
                            <tr>
                              {row.map((cell) => <td class="font-medium">{cell}</td>)}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}

                  {phase.matrix && (
                    <div class="overflow-x-auto mt-4">
                      <table class="table table-bordered table-sm text-center">
                        <thead>
                          <tr>
                            <th></th>
                            {phase.matrix.cols.map((col) => (
                              <th class="text-error">{col}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {phase.matrix.rows.map((row) => (
                            <tr>
                              <th class="text-info">{row.label}</th>
                              <td class="whitespace-pre-line text-xs">{row.acidosis}</td>
                              <td class="whitespace-pre-line text-xs">{row.alkalosis}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}

                  {phase.fiveSteps && (
                    <div class="mt-4">
                      <div class="alert alert-warning text-sm mb-3">
                        <span class="font-bold">The 5-Step Framework</span>
                      </div>
                      <ul class="steps steps-vertical">
                        {phase.fiveSteps.map((s) => (
                          <li class="step step-warning">
                            <div class="text-left">
                              <span class="font-semibold">Step {s.step} — {s.label}:</span>
                              <span class="text-sm text-base-content/70"> {s.detail}</span>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <div class="mt-4 flex justify-end">
                    <a href={`/abg/phase/${phase.number}`} class={`btn btn-sm ${phase.badge.replace('badge-', 'btn-')}`}>
                      Go to Phase {phase.number} →
                    </a>
                  </div>
                </div>
              </div>
            </div>
            {index < phases.length - 1 && <hr class="bg-primary" />}
          </li>
        );
      })}
    </ul>

    <!-- Pedagogical Principles -->
    <div class="card bg-base-100 shadow-lg mt-10">
      <div class="card-body">
        <h2 class="card-title text-2xl mb-4">
          <span class="text-2xl">📚</span> Key Pedagogical Principles Woven Throughout
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {pedagogicalPrinciples.map((principle) => (
            <div class="bg-base-200 rounded-box p-4">
              <h3 class="font-bold text-primary mb-1">{principle.title}</h3>
              <p class="text-sm text-base-content/70">{principle.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer footer-center p-6 mt-10 text-base-content/50 text-sm">
      <p>ABG Interpretation Educational Tool · Built with <a href="https://astro.build" class="link link-primary">Astro</a> & <a href="https://daisyui.com" class="link link-primary">DaisyUI</a></p>
    </footer>
  </div>
</Layout>
